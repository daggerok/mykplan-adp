{
  "name": "mykplan-adp",
  "version": "0.5.3",
  "private": true,
  "description": "Own viewer for ADP mykplan 401k data: sync, returns, charts, forecasts",
  "type": "module",
  "scripts": {
    "dev": "bun --hot scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "build:pages": "BASE=/mykplan-adp/ bun scripts/build.ts",
    "userscript": "bun --watch scripts/build-userscript.ts",
    "import-raw": "bun scripts/import-raw.ts",
    "test": "bun test"
  },
  "author": "Maksim Kostromin / daggerok",
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "lightweight-charts": "5.3.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@types/bun": "1.4.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bun-plugin-tailwind": "0.1.2",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.5"
  }
}
